# ============================================================================
# .env.example — modelo de configuração do acesso ao LLM (P0)
# ----------------------------------------------------------------------------
# Copie este arquivo para ".env" e preencha os VALORES reais:
#     cp .env.example .env
# O ".env" fica FORA do versionamento (.gitignore já o protege). NUNCA commite
# um arquivo .env com credenciais — este repositório é público.
#
# Os três nomes abaixo são obrigatórios; o programa falha de forma controlada
# indicando apenas o NOME da variável ausente, jamais o valor.
# Preencha-os conforme a documentação do serviço de LLM escolhido e as
# orientações institucionais (fórum do P0 / manual do serviço), quando aplicável.
# ============================================================================

# Base URL do endpoint compatível com a API OpenAI fornecido pelo serviço.
# Use exatamente o endereço indicado pela documentação do serviço — sem
# substituir por IP. Exemplo de formato (NÃO é um valor real):
#     https://SEU-SERVICO.exemplo/v1
LLM_BASE_URL=https://substitua-pelo-endpoint-do-servico/v1

# Chave de acesso (token) do serviço. Mantenha em segredo: não compartilhe,
# não cole em logs, prints, vídeos ou issues. O valor costuma começar com um
# prefixo próprio do serviço (por exemplo, uma sequência alfanumérica longa).
LLM_API_KEY=cole-aqui-sua-chave-sem-publicar

# Nome exato do modelo a usar (um único LLM, conforme o enunciado do P0).
# Consulte o identificador fornecido pela documentação do serviço escolhido.
LLM_MODEL=substitua-pelo-nome-do-modelo

# ----------------------------------------------------------------------------
# Parâmetros de geração OPCIONAIS (Nível Avançado — item 1)
# ----------------------------------------------------------------------------
# Estes três são opcionais: se você não os definir (ou deixar em branco), o
# programa simplesmente não os envia e o provedor aplica seus próprios padrões.
# Ajustá-los aqui muda a requisição SEM editar o código-fonte. Valores inválidos
# geram mensagem clara citando apenas o NOME da variável (nunca um segredo).

# Limite máximo de tokens na resposta (inteiro positivo). Ex.: 512
# LLM_MAX_TOKENS=512

# Criatividade da amostragem, entre 0 e 2 (float). Menos = mais determinístico.
# Ex.: 0.3
# LLM_TEMPERATURE=0.3

# Tempo máximo de espera pela resposta, em segundos (maior que zero). Ex.: 30
# LLM_TIMEOUT=30
